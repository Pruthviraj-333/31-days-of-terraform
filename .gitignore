# Local .terraform directories
**/.terraform/

# .tfstate files
*.tfstate
*.tfstate.*

# Crash logs
crash.log
crash.*.log

# Exclude all .tfvars files, which are likely to contain sensitive data
*.tfvars
*.tfvars.json

# Ignore override files as they may contain local configurations
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# OS generated files
.DS_Store
Thumbs.db
